# --- Data protection (ADR-0005) -------------------------------------------
# Raw event logs are patient-identifiable by construction: bed + timestamp
# identifies a person. Nothing resembling real data enters version control.
data/
artefacts/
*.csv
*.xes
*.parquet
*.sqlite
.salt
*.salt
!tests/fixtures/**/*.csv          # synthetic only, no real people

# --- Context retrieval index (SPEC-007 Part A, ADR-0007) -------------------
# Build artefact: a chunking of docs/ + src/hwpm/ + refs/metaheuristics/,
# regenerated by `hwpm context index`. Not source, and touches no patient
# data, but a build artefact belongs out of version control regardless.
.hwpm/

# --- Licensed reference material (refs/metaheuristics/README.md) -----------
# Essentials of Metaheuristics is CC BY-ND: redistributing a transformed copy
# is not permitted. Regenerate locally with tools/parse_reference_pdf.py.
refs/metaheuristics/*.pdf
refs/metaheuristics/essentials-of-metaheuristics.md
refs/metaheuristics/*.rawtext

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Native (ADR-0003) ----------------------------------------------------
*.so
*.dll
*.dylib
*.o
*.obj

# --- OS / editor ----------------------------------------------------------
.DS_Store
Thumbs.db
.thumbnail
.idea/
.vscode/

# --- Claude Code session state (machine/process-local, never shared) -------
.claude/scheduled_tasks.lock
.claude/session-env/
